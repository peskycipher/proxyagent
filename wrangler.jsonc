{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxy-agent",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proxy-agent-db",
      "database_id": "bb726e2e-e54b-4892-982a-dd3e6ef7f62b"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "POD_CONTROLLER",
        "class_name": "PodController"
      }
    ]
  },
  "send_email": [
    {
      "name": "NOTIFY_OPS",
      "destination_address": "payments@proxyagent.rent"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PodController"]
    }
  ],
  "vars": {
    "TURNSTILE_HOSTNAMES": "proxyagent.rent",
    "BASE_URL": "https://proxyagent.rent"
  }
}