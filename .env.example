# Auth
AUTH_SECRET=change-me-openssl-rand-hex-32

# App
BASE_URL=http://localhost:3000

# Pod / llama.cpp
RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxx
RUNPOD_POD_ID=wrr67kydajnh81
LLAMA_SERVER_URL=https://llama.proxyagent.rent
# Optional: if llama-server was started with --api-key
LLAMA_API_KEY=
# llama-server's --alias / model id — llama.cpp ≥0.5.0-dev rejects chat
# requests that omit `model` (worker error: "model name is missing")
LLAMA_MODEL_ID=
# Vast.ai direct provider (idle-scales to zero; IP re-resolved from the API).
# An https:// LLAMA_SERVER_URL (e.g. Cloudflare Tunnel hostname) counts as a
# stable front and is never overridden with the learned pod IP/port.
VAST_API_KEY=
VAST_INSTANCE_ID=

# Pod automation (idle → stopped after this many seconds)
POD_IDLE_TIMEOUT_SECONDS=300
POD_WARMUP_TIMEOUT_SECONDS=300

# CryptAPI: payout wallet per accepted coin (lowercase ticker)
CRYPTAPI_WALLETS_BTC=bc1qxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CRYPTAPI_WALLETS_LTC=ltc1qxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Self-hosted: trust the host header (behind reverse proxy/tunnel)
AUTH_TRUST_HOST=true

# SSO (optional — set a pair to enable that button on /login)
# Google: https://console.cloud.google.com/apis/credentials → OAuth client ID
#   Authorized redirect URI: {BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: Settings → Developer settings → OAuth Apps → New OAuth App
#   Authorization callback URL: {BASE_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Turnstile captcha (opt-in — login/signup captcha renders only when set):
#   https://dash.cloudflare.com → Turnstile → Add widget (domains: localhost + prod)
#   Dev: the always-passing test sitekey 1x00000000000000000000AA with TURNSTILE_SECRET
#   unset (verification is a no-op without it; Cloudflare's test secret key omits
#   `action` at siteverify and fails the strict checks in src/lib/turnstile.ts).
#   Prod: real sitekey at build time, real secret via `wrangler secret put TURNSTILE_SECRET`,
#   TURNSTILE_HOSTNAMES already set in wrangler.jsonc (never include localhost in prod).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=        # Worker secret, not a .env var in production
# TURNSTILE_HOSTNAMES=localhost,127.0.0.1
